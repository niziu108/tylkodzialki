generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String?   @unique
  emailVerified            DateTime?
  image                    String?
  passwordHash             String?
  role                     Role      @default(USER)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  listingCredits           Int       @default(0)
  listingCreditsExpiresAt  DateTime?
  featuredCredits          Int       @default(0)
  featuredCreditsExpiresAt DateTime?

  defaultTelefon         String?
  defaultSprzedajacyTyp  SprzedajacyTyp?
  defaultSprzedajacyImie String?
  defaultBiuroNazwa      String?
  defaultBiuroOpiekun    String?
  defaultBiuroLogoUrl    String?
  // Zielone tło pod logo biura — dla białych/jasnych logotypów, które na jasnym tle znikają.
  defaultBiuroLogoBg     Boolean         @default(false)

  // Wizytówka biura (karta partnerska). NIE jest to katalog biur ani funkcja dla każdego:
  // włączamy ją ręcznie z admina wybranym partnerom z realną liczbą ofert. Strona nie jest
  // linkowana z nawigacji ani z sitemapy — jedyne wejście to logo/link przy ofercie biura.
  biuroWizytowkaOn         Boolean @default(false)
  // Status partnera strategicznego. Nadawany RĘCZNIE i wyłącznie sieciom, które wnoszą realną
  // podaż: znaczek pojawia się przy każdej ofercie biura, więc rozdany szeroko przestaje
  // cokolwiek znaczyć i zamienia listę wyników w choinkę. Świadomie NIE jest to stopień
  // najwyższy („główny dostawca"), żeby nie trzeba go było odbierać, gdy dojdzie ktoś większy.
  biuroPartnerStrategiczny Boolean @default(false)
  // Logotypy sieci (RE/MAX, Freedom) mają nazwę wpisaną w znak, więc nagłówek z tą samą
  // nazwą tuż pod logo dublował ją na wizytówce. Ten przełącznik chowa nazwę WIZUALNIE:
  // h1 zostaje w kodzie strony jako `sr-only`, bo to jedyny nagłówek tej strony i musi
  // widzieć go Google oraz czytnik ekranu. Działa tylko przy wgranym logo, inaczej
  // wizytówka zostałaby bez żadnego tytułu na wierzchu.
  biuroNazwaWLogo          Boolean @default(false)

  // Zakres portfela („działki od X zł, powierzchnie od Y do Z m²") liczy się z feedu, więc
  // dziedziczy jego bałagan: wynajem oznaczony jako sprzedaż robi z czynszu cenę działki,
  // a powierzchnia w hektarach zaniża dolną granicę. Bramki łapią to, co da się rozpoznać
  // pewnie (patrz crm/area-sanity.ts), ale rodzaju transakcji nie da się zgadnąć z tekstu:
  // „pod domki na wynajem" to sprzedaż. Zamiast poprawiać dane biura zgadywanką, dajemy
  // sobie wyłącznik: portfel z bałaganem po prostu nie dostaje tego zdania.
  biuroZakresUkryty        Boolean @default(false)

  biuroSlug                String? @unique
  biuroOpis                String?
  biuroTelefon             String?
  biuroEmail               String?
  biuroAdres               String?
  // Adres www biura. Pole opcjonalne i domyślnie puste: wypuszczanie kupującego z portalu
  // to koszt, więc link zapala się WYŁĄCZNIE tam, gdzie sami go wpiszemy — element
  // negocjacji z partnerem strategicznym, nie standard wizytówki.
  biuroWww                 String?
  biuroRokZalozenia        Int?
  biuroLiczbaOddzialow     Int?

  accounts           Account[]
  crmIntegrations    CrmIntegration[]
  creditTransactions ListingCreditTransaction[]
  dzialki            Dzialka[]
  favoriteDzialki    FavoriteDzialka[]
  emailSendLogs      EmailSendLog[]
  invoices           Invoice[]
  listingOrders      ListingOrder[]
  offerAlerts        OfferAlert[]
  biuroDailyStats    BiuroDailyStat[]
  sessions           Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Dzialka {
  id             String          @id @default(cuid())
  tytul          String
  cenaPln        Int
  powierzchniaM2 Int
  transakcja     TransakcjaTyp   @default(SPRZEDAZ)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  editToken      String          @unique
  email          String?
  expiresAt      DateTime?
  lat            Float?
  lng            Float?
  locationFull   String?
  locationLabel  String?
  locationMode   LocationMode    @default(EXACT)
  mapsUrl        String?
  parcelText     String?
  placeId        String?
  przeznaczenia  Przeznaczenie[]
  telefon        String

  // Oś administracyjna ustalona z lat/lng przez ULDK (GUGiK), NIE z tekstu w feedzie biura.
  // Powód: `locationFull` z CRM bywa niespójny („Łódzkie", „Dąbrowica, koniński"), przez co
  // ~11% ofert wypadało z hubów powiatowych. Punkt oferty jest przybliżony, ale przybliżenie
  // rzędu setek metrów nie zmienia gminy ani powiatu, więc ta precyzja jest uczciwa.
  // ŚWIADOMIE nie zapisujemy pełnego identyfikatora działki ewidencyjnej — ten nadal podaje
  // użytkownik w „Sprawdź działkę" (FILOZOFIA: precyzję działki podaje UŻYTKOWNIK).
  // `adminTeryt` = 6-cyfrowy kod gminy (powiat = 4 pierwsze cyfry); klucz pod agregaty RCN.
  adminTeryt     String?
  adminWoj       String?
  adminPowiat    String?
  adminGmina     String?
  adminAt        DateTime?

  sprzedajacyImie String?
  biuroNazwa      String?
  biuroOpiekun    String?
  biuroLogoUrl    String?

  klasaZiemi         String?
  ksiegaWieczysta    String?
  mpzp               Boolean           @default(false)
  projektDomu        Boolean           @default(false)
  wymiary            String?
  wzWydane           Boolean           @default(false)
  numerOferty        String?
  sprzedajacyTyp     SprzedajacyTyp    @default(PRYWATNIE)
  kanalizacja        KanalizacjaStatus @default(BRAK)
  gaz                GazStatus         @default(BRAK)
  swiatlowod         SwiatlowodStatus  @default(BRAK)
  dojazd             DojazdStatus      @default(BRAK_INFORMACJI)
  prad               PradStatus        @default(BRAK_PRZYLACZA)
  woda               WodaStatus        @default(BRAK_PRZYLACZA)
  opis               String?
  ownerId            String?
  endedAt            DateTime?
  publishedAt        DateTime          @default(now())
  status             DzialkaStatus     @default(AKTYWNE)
  featuredUntil      DateTime?
  isFeatured         Boolean           @default(false)
  detailViewsCount   Int               @default(0)
  viewsCount         Int               @default(0)
  phoneClicksCount   Int               @default(0)
  messageClicksCount Int               @default(0)

  sourceType      DzialkaSourceType @default(MANUAL)
  crmImportedAt   DateTime?
  crmLastSyncedAt DateTime?

  owner          User?                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  crmOfferLinks  CrmOfferLink[]
  crmSyncLogs    CrmSyncLog[]
  zdjecia        Zdjecie[]
  favoritedBy    FavoriteDzialka[]
  perelkaUzyta   PerelkaUzyta?
  priceSnapshots DzialkaPriceSnapshot[]
  listingSpells  DzialkaListingSpell[]

  @@index([lat, lng])
  @@index([ownerId])
  @@index([status])
  @@index([expiresAt])
  @@index([isFeatured])
  @@index([featuredUntil])
  @@index([sourceType])
  @@index([crmLastSyncedAt])
  // P12 (skalowanie): złożone indeksy pod dominujące zapytania listy /kup — filtr status=AKTYWNE
  // + sort/paginacja po dacie/cenie/powierzchni. Wspierają count i ORDER BY ... LIMIT przy 50k+.
  @@index([status, createdAt])
  @@index([status, cenaPln])
  @@index([status, powierzchniaM2])
  // Oś administracyjna (huby powiatowe + agregaty cen per gmina).
  @@index([adminTeryt])
  @@index([status, adminTeryt])
}

// Perełka „zużyta" — poszła już na posta na FB/Insta i ma nie wracać na listę w /admin/perelki.
// Znacznik trzyma się poza modelem Dzialka, bo to nasza notatka redakcyjna, a nie cecha oferty:
// nie ma wpływu na wyszukiwarkę ani na to, co widzi kupujący. Rekord zostaje po zdjęciu oferty
// z listy tylko przez czas jej życia (kaskada), a to i tak wystarczy — nieaktywna oferta nie jest
// kandydatem.
model PerelkaUzyta {
  id        String   @id @default(cuid())
  dzialkaId String   @unique
  usedAt    DateTime @default(now())
  dzialka   Dzialka  @relation(fields: [dzialkaId], references: [id], onDelete: Cascade)

  @@index([usedAt])
}

model Zdjecie {
  id        String   @id @default(cuid())
  url       String
  publicId  String
  kolejnosc Int      @default(0)
  dzialkaId String
  createdAt DateTime @default(now())
  dzialka   Dzialka  @relation(fields: [dzialkaId], references: [id], onDelete: Cascade)

  @@index([dzialkaId])
}

model FavoriteDzialka {
  id        String   @id @default(cuid())
  userId    String
  dzialkaId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dzialka Dzialka @relation(fields: [dzialkaId], references: [id], onDelete: Cascade)

  @@unique([userId, dzialkaId])
  @@index([userId])
  @@index([dzialkaId])
}

model OfferAlert {
  id               String          @id @default(cuid())
  // P26: alert może istnieć bez konta (subskrypcja na sam e-mail z double opt-in).
  // Zalogowany: userId ustawione, email z konta, confirmedAt od razu. Anonim: userId null,
  // email podany, alert nieaktywny do potwierdzenia (confirmToken -> confirmedAt).
  userId           String?
  email            String?
  confirmToken     String?         @unique
  confirmedAt      DateTime?
  label            String
  query            String?
  priceMin         Int?
  priceMax         Int?
  areaMin          Int?
  areaMax          Int?
  przeznaczenia    Przeznaczenie[]
  transakcja       TransakcjaTyp[]
  lat              Float?
  lng              Float?
  radiusKm         Int?
  isActive         Boolean         @default(true)
  unsubscribeToken String          @unique
  lastCheckedAt    DateTime        @default(now())
  lastNotifiedAt   DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([email])
}

// P16 (fundament raportu leadów): dzienny snapshot kumulacyjnych liczników PER BIURO (właściciel ofert).
// Liczniki na Dzialka są kumulacyjne i bez znacznika czasu, więc „dzień po dniu" wyliczamy jako różnicę
// między snapshotami. Jeden wiersz = jedno biuro × jeden dzień; sumy ze WSZYSTKICH ofert właściciela
// na koniec danego dnia. Addytywne, nie rusza istniejących danych (źródło prawdy zostaje na Dzialka).
model BiuroDailyStat {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime @db.Date
  viewsCount         Int      @default(0)
  detailViewsCount   Int      @default(0)
  phoneClicksCount   Int      @default(0)
  messageClicksCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// Trend cen: dzienny snapshot mediany zł/m² TYPOWYCH działek budowlanych (metraż pod dom)
// per miasto SEO. Jeden wiersz = jedno miasto × jeden dzień. Z serii kolejnych dni rysujemy
// trend na stronie /ceny/[miasto]. Addytywne, nie rusza istniejących danych (źródło ofert
// zostaje na Dzialka); citySlug pochodzi ze statycznej konfiguracji, więc bez klucza obcego.
model CityPriceDailyStat {
  id               String   @id @default(cuid())
  citySlug         String
  date             DateTime @db.Date
  medianPricePerM2 Int // mediana zł/m² typowych działek budowlanych
  sampleCount      Int // liczba ofert, na których policzono medianę
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([citySlug, date])
  @@index([citySlug])
  @@index([date])
}

// Historia cen per działka. Zapisujemy wiersz TYLKO gdy cena (lub metraż) różni się od ostatniego
// znanego stanu tej oferty — to change-log, nie codzienna migawka wszystkich ofert, więc rośnie
// wolno. Pierwszy przebieg zakłada linię bazową dla każdej aktywnej oferty. Z serii wierszy rysujemy
// trend ceny KONKRETNEJ działki (fundament land intelligence). Addytywne, nie rusza Dzialka (źródło
// prawdy zostaje na Dzialka.cenaPln). powierzchniaM2 kopiowane, by liczyć zł/m² w czasie nawet gdy
// metraż później skorygowano. Data w strefie PL (jak pozostałe snapshoty), unikat (dzialkaId,date).
model DzialkaPriceSnapshot {
  id             String   @id @default(cuid())
  dzialkaId      String
  date           DateTime @db.Date
  cenaPln        Int
  powierzchniaM2 Int
  createdAt      DateTime @default(now())

  dzialka Dzialka @relation(fields: [dzialkaId], references: [id], onDelete: Cascade)

  @@unique([dzialkaId, date])
  @@index([dzialkaId])
  @@index([date])
}

// Epizod życia oferty („spell"): od chwili, gdy działka trafiła na portal, do chwili, gdy z niego
// zeszła. Jedna działka może mieć wiele epizodów, bo oferta potrafi zniknąć z feedu biura i wrócić
// po miesiącach, często po obniżce. Tabela jest dopisywana, nigdy nadpisywana: to jedyne miejsce,
// w którym ta historia zostaje, bo reaktywacja oferty czyści `Dzialka.endedAt` i przestawia
// `publishedAt` na teraz. Bez tego czas sprzedaży działki jest nie do policzenia wstecz.
//
// Zapisem steruje rekoncyliator (src/lib/listing-spells.ts), a nie silniki importu. Świadomie:
// import 126 biur ma prawo być ważniejszy niż statystyka i nie może się wywrócić przez zapis obok.
model DzialkaListingSpell {
  id             String            @id @default(cuid())
  dzialkaId      String
  startedAt      DateTime
  endedAt        DateTime?
  cenaStart      Int
  cenaEnd        Int?
  powierzchniaM2 Int
  endReason      SpellEndReason?
  provider       CrmProvider?
  sourceType     DzialkaSourceType @default(MANUAL)
  // false = epizod odtworzony, a nie zmierzony: dane sprzed naprawy sygnału `<oferta_usun>`
  // (17.08.2026) albo koniec wywnioskowany z nadpisanego `publishedAt`. Do median się nie liczy.
  reliable       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  dzialka Dzialka @relation(fields: [dzialkaId], references: [id], onDelete: Cascade)

  @@unique([dzialkaId, startedAt])
  @@index([dzialkaId])
  @@index([endedAt])
  @@index([provider, endedAt])
  @@index([reliable, endedAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model AppConfig {
  id                     String  @id @default(cuid())
  paymentsEnabled        Boolean @default(false)
  freeListingCredits     Int     @default(0)
  freeListingCreditsDays Int?

  listingSinglePriceGrossPln Int @default(1900)
  listingPack10PriceGrossPln Int @default(14900)
  listingPack40PriceGrossPln Int @default(39900)

  featuredSinglePriceGrossPln Int @default(1900)
  featuredPack3PriceGrossPln  Int @default(3900)

  // CRM Sprint 2: globalny wyłącznik automatycznej synchronizacji.
  // OFF = bezpiecznie (nic się nie kolejkuje samo); włączenie/wyłączenie bez deployu.
  crmAutoSyncEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ListingCreditTransaction {
  id           String                  @id @default(cuid())
  userId       String
  delta        Int
  balanceAfter Int
  sourceType   ListingCreditSourceType
  note         String?
  expiresAt    DateTime?
  orderId      String?
  createdAt    DateTime                @default(now())
  order        ListingOrder?           @relation(fields: [orderId], references: [id])
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([sourceType])
}

model ListingOrder {
  id                    String                     @id @default(cuid())
  userId                String
  packageType           ListingPackageType
  packageName           String
  credits               Int
  validityDays          Int?
  amountGrossPln        Int
  currency              String                     @default("PLN")
  status                ListingPaymentStatus       @default(PENDING)
  stripeSessionId       String?                    @unique
  stripePaymentIntentId String?                    @unique
  paidAt                DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  featuredCredits       Int                        @default(0)
  buyerAddressLine1     String?
  buyerCity             String?
  buyerCompanyName      String?
  buyerEmail            String?
  buyerNip              String?
  buyerPostalCode       String?
  invoiceIssuedAt       DateTime?
  invoiceNumber         String?
  invoicePdfUrl         String?
  invoiceType           BuyerInvoiceType           @default(NONE)
  creditTransactions    ListingCreditTransaction[]
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([packageType])
}

model Invoice {
  id                    String            @id @default(cuid())
  userId                String
  stripeSessionId       String?           @unique
  stripePaymentIntentId String?           @unique
  stripeCheckoutUrl     String?
  invoiceNumber         String?           @unique
  type                  SalesInvoiceType
  status                InvoiceStatus     @default(PENDING)
  source                InvoiceSource     @default(INTERNAL)
  amountGross           Int
  currency              String            @default("PLN")
  companyName           String?
  nip                   String?
  addressLine1          String?
  addressLine2          String?
  postalCode            String?
  city                  String?
  country               String?           @default("PL")
  invoiceEmail          String?
  itemName              String?
  quantity              Int               @default(1)
  issuedAt              DateTime?
  paidAt                DateTime?
  pdfPath               String?
  pdfFileName           String?
  ksefReferenceNumber   String?
  ksefInvoiceNumber     String?
  ksefSentAt            DateTime?
  ksefAcceptedAt        DateTime?
  ksefErrorMessage      String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  buyerName             String?
  ksefRequired          Boolean           @default(true)
  buyerType             InvoiceBuyerType?
  ksefStatus            KsefStatus        @default(READY)
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([buyerType, createdAt])
  @@index([ksefStatus, createdAt])
  @@index([invoiceNumber])
  @@index([nip])
}

model EmailSendLog {
  id          String        @id @default(cuid())
  type        EmailSendType
  campaignKey String
  email       String
  userId      String?
  sentAt      DateTime      @default(now())
  user        User?         @relation(fields: [userId], references: [id])

  @@unique([type, campaignKey, email])
  @@index([userId])
  @@index([campaignKey])
}

model Article {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  excerpt        String?
  content        String
  imageUrl       String?
  category       String?
  readingTime    Int?
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([isPublished, createdAt])
}

model CrmIntegration {
  id       String      @id @default(cuid())
  userId   String
  name     String
  provider CrmProvider @default(GALACTICA)
  isActive Boolean     @default(true)

  transportType CrmTransportType @default(FTP)
  feedFormat    CrmFeedFormat    @default(DOMY_PL)

  ftpHost             String?
  ftpPort             Int?    @default(21)
  ftpUsername         String?
  ftpPassword         String?
  ftpRemotePath       String?
  ftpPassive          Boolean @default(true)
  expectedFilePattern String? @default("oferty_*.zip")
  fullImportMode      Boolean @default(true)

  apiKeyHash   String?
  apiKeyPrefix String?
  apiKeyLast4  String?

  lastUsedAt       DateTime?
  lastSyncAt       DateTime?
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?

  lastImportedOffers   Int @default(0)
  lastCreatedCount     Int @default(0)
  lastUpdatedCount     Int @default(0)
  lastDeactivatedCount Int @default(0)
  lastSkippedCount     Int @default(0)
  lastErrorCount       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerLinks     CrmOfferLink[]
  syncLogs       CrmSyncLog[]
  importJobs     CrmImportJob[]
  processedFiles CrmProcessedFile[]

  @@unique([userId, name])
  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@index([transportType])
  @@index([feedFormat])
}

model CrmOfferLink {
  id                String    @id @default(cuid())
  integrationId     String
  dzialkaId         String
  externalId        String
  externalUpdatedAt DateTime?
  lastImportedAt    DateTime?
  lastSeenAt        DateTime?
  lastPublishedAt   DateTime?
  lastDeactivatedAt DateTime?
  isActiveInSource  Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  integration CrmIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  dzialka     Dzialka        @relation(fields: [dzialkaId], references: [id], onDelete: Cascade)
  syncLogs    CrmSyncLog[]

  @@unique([integrationId, externalId])
  @@index([integrationId])
  @@index([dzialkaId])
  @@index([externalId])
  @@index([isActiveInSource])
  @@index([lastSeenAt])
}

model CrmSyncLog {
  id            String        @id @default(cuid())
  integrationId String
  dzialkaId     String?
  offerLinkId   String?
  externalId    String?
  action        CrmSyncAction
  status        CrmSyncStatus
  message       String?
  payload       Json?
  createdAt     DateTime      @default(now())

  integration CrmIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  dzialka     Dzialka?       @relation(fields: [dzialkaId], references: [id], onDelete: SetNull)
  offerLink   CrmOfferLink?  @relation(fields: [offerLinkId], references: [id], onDelete: SetNull)

  @@index([integrationId, createdAt])
  @@index([dzialkaId])
  @@index([offerLinkId])
  @@index([externalId])
  @@index([action, status])
}

model CrmImportJob {
  id            String         @id @default(cuid())
  integrationId String
  integration   CrmIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  status CrmImportJobStatus @default(PENDING)

  startedAt    DateTime?
  finishedAt   DateTime?
  message      String?
  errorMessage String?

  remoteFileName String?

  importedOffers   Int @default(0)
  createdCount     Int @default(0)
  updatedCount     Int @default(0)
  deactivatedCount Int @default(0)
  skippedCount     Int @default(0)
  errorCount       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([integrationId])
  @@index([status])
  @@index([createdAt])
}

model CrmProcessedFile {
  id               String    @id @default(cuid())
  integrationId    String
  remoteFileName   String
  fileSize         BigInt?
  fileModifiedAt   DateTime?
  status           String    @default("SUCCESS")
  isFullExport     Boolean   @default(false)
  importedOffers   Int       @default(0)
  createdCount     Int       @default(0)
  updatedCount     Int       @default(0)
  deactivatedCount Int       @default(0)
  skippedCount     Int       @default(0)
  errorCount       Int       @default(0)
  message          String?
  processedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  integration CrmIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, remoteFileName])
  @@index([integrationId])
  @@index([status])
  @@index([processedAt])
  @@index([remoteFileName])
}

// Deweloper z listy kontaktowej (P: silnik popytu po stronie kupujących hurtowo).
// To NIE jest konto w serwisie ani wizytówka: to nasza prywatna call/mail lista firm,
// które kupują grunt. Import z katalogu panoramafirm.pl, obsługa w /admin/deweloperzy.
// Rekord trzyma tylko dane kontaktowe firmy (publiczne w katalogu) i historię naszego kontaktu.
model Deweloper {
  id          String  @id @default(cuid())
  // klucz importu: nazwa + miejscowość po normalizacji, żeby ponowny import nie dublował firm
  sourceKey   String  @unique
  nazwa       String
  miejscowosc String?
  // slug województwa zgodny z SEO_REGIONS (dolnoslaskie, mazowieckie, ...)
  wojewodztwo String
  telefon     String?
  email       String?
  www         String?
  adres       String?
  // A = telefon i mail, B = sam telefon, C = sam mail, D = brak kontaktu
  priorytet   String  @default("D")
  uwagi       String?

  status        DeweloperStatus @default(NOWY)
  lastContactAt DateTime?
  followUpAt    DateTime?
  notatki       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priorytet])
  @@index([wojewodztwo, status])
  @@index([followUpAt])
}

enum DeweloperStatus {
  NOWY
  WYSLANY
  ODPOWIEDZ
  ROZMOWA
  KLIENT
  ODPADA
}

